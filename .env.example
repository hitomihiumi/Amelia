# Rename this file to `.env` and replace the placeholder values with your actual configuration.
# This file contains environment variables for your application.

# Discord bot configuration

TOKEN=
DEV_TOKEN=
NODE_ENV=production

# Public address of the dashboard, used for report/appeal form links in DMs.
# Example: https://amelia.example.com
DASHBOARD_URL=

# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=amelia
# Major PostgreSQL version of the docker image. Change it only with `npm run db -- upgrade-pg <major>`,
# a plain edit leaves the old data directory unreadable for the new server.
POSTGRES_VERSION=15
DATABASE_URL=postgresql://user:password@postgres:5432/amelia

# Redis configuration for temp data caching and the status heartbeat.
# With a password: REDIS_PASSWORD=... and REDIS_URL=redis://:<password>@redis:6379 (a password with special
# characters must be URL-encoded in REDIS_URL).
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# Only for docker-compose.remote.yml (database reached from another host, e.g. a dashboard on Vercel):
# POSTGRES_PUBLIC_PORT=5433
# REDIS_TLS_PORT=6380

# Firewall (scripts/firewall.sh), only for a host that exposes the databases
# SSH_PORT=22
# ADMIN_CIDRS=203.0.113.7/32
# DB_CIDRS=
# EXTRA_TCP_PORTS=
# WAN_IF=eth0
