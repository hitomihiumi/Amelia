# Rename this file to `.env` and replace the placeholder values with your actual configuration.
# This file contains environment variables for your application.

# Discord bot configuration

TOKEN=
DEV_TOKEN=
NODE_ENV=production

# Public address of the dashboard, used for report/appeal form links in DMs.
# Example: https://amelia.example.com
DASHBOARD_URL=

# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=amelia
DATABASE_URL=postgresql://user:password@postgres:5432/amelia

# MongoDB configuration for temp data caching
MONGODB_USER=user
MONGODB_PASSWORD=password
MONGODB_URL=mongodb://user:password@mongodb:27017/amelia?authSource=admin

